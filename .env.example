# ==============================================================================
# Variaveis de Ambiente - Infraestrutura Local (Docker Compose)
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente.
# ==============================================================================

# Porta do SQL Server exposta no host
MSSQL_PORT=1433

# Senha do usuario 'sa' do SQL Server (minimo de 8 caracteres, maiusculas, minusculas e simbolos)
MSSQL_SA_PASSWORD=SuaSenhaForteAqui@2026!

# Edicao do SQL Server (Developer, Express, Standard)
MSSQL_PID=Developer

# Nome do Banco de Dados padrao da aplicacao
MSSQL_DATABASE=CieeCurriculosDb
